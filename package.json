{
  "name": "@openmeshtak/sdk",
  "version": "0.3.1",
  "description": "Official TypeScript and JavaScript client for the OpenMeshTak API",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.12.0"
  },
  "packageManager": "pnpm@10.12.4",
  "openmeshtak": {
    "apiVersionRange": ">=0.3.1 <0.4.0",
    "openApiVersion": "0.3.1"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generated": {
      "types": "./dist/generated/schema.d.ts",
      "import": "./dist/generated.js"
    }
  },
  "scripts": {
    "api:generate": "openapi-typescript openapi/openapi.json --output src/generated/schema.ts",
    "api:sync": "node scripts/sync-openapi.mjs",
    "generate": "pnpm api:generate && node scripts/write-version-module.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm build && node --test",
    "license:check": "node scripts/check-licenses.mjs",
    "release:notices": "node scripts/write-release-notices.mjs",
    "version:check": "node scripts/check-version.mjs",
    "version:set": "node scripts/set-version.mjs",
    "check": "pnpm version:check && pnpm typecheck && pnpm test && pnpm license:check",
    "prepack": "pnpm check && pnpm release:notices"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenMeshTAK/openmeshtak-sdk.git"
  },
  "homepage": "https://openmeshtak.github.io/openmeshtak-docs/sdk/",
  "bugs": {
    "url": "https://github.com/OpenMeshTAK/openmeshtak-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "openmeshtak",
    "tak",
    "atak",
    "itak",
    "tak-server",
    "meshtastic",
    "lora",
    "openapi",
    "api-client",
    "sdk",
    "typescript"
  ]
}
